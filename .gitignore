# Environment files with secrets (see .env.example)
.env
.env.local
.env.*.local

# Dependencies
node_modules/
mobile/ios/Pods/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# API uploads
api/storage/temp/*
api/storage/uploads/*
!api/storage/temp/.gitkeep
!api/storage/uploads/.gitkeep

# Android / iOS build artifacts and signing keys
mobile/android/.gradle/
mobile/android/app/build/
*.keystore
*.jks
mobile/ios/build/
*.xcuserstate
xcuserdata/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS files
.vscode/
.idea/
.DS_Store
